# PostgreSQL database (local or hosted)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/frontdesk
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
# All nine demo agents use this password; choose a unique password for hosting.
SEED_AGENT_PASSWORD=replace-with-long-demo-password
PORT=3001
# Comma-separated YYYY-MM-DD festival/public holidays (IST). Empty by default.
HOLIDAYS=2026-12-25
NODE_ENV=development
