# Copy to .env and replace the placeholders for your local database.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/frontdesk
SESSION_SECRET=replace-with-at-least-32-random-characters
# Set before first startup. Production requires at least 12 characters.
SEED_AGENT_PASSWORD=replace-with-a-dedicated-seed-password
PORT=3001
NODE_ENV=development
# Comma-separated YYYY-MM-DD dates in IST. Leave empty to exclude weekends only.
HOLIDAYS=
# Optional: set only for a separate, disposable database used by integration tests.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/frontdesk_test
